#!/bin/bash

# Simple wrapper to open Cursor from Homebrew installation
CURSOR_APP="$(brew --prefix)/Caskroom/cursor/1.2.1,031e7e0ff1e2eda9c1a0f5df67d44053b059c5df/Cursor.app"

if [ $# -eq 0 ]; then
    # No arguments, just open Cursor
    open "$CURSOR_APP"
else
    # Open Cursor with the specified file/directory
    open -a "$CURSOR_APP" "$@"
fi

ls -l ~/bin/cursor